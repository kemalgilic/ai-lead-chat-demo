      "parameters": {
        "jsCode": "const freeEmailDomains = ['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com','aol.com','gmx.com'];\nconst item = $input.first().json;\n\nconst email = (item['Work Email'] || '').trim().toLowerCase();\nconst domain = email.split('@')[1] || '';\n\nreturn [{\n  json: {\n    lead_id: $workflow.id + '-' + Date.now(),\n    full_name: item['Full Name'],\n    work_email: email,\n    email_domain: domain,\n    is_free_email_domain: freeEmailDomains.includes(domain),\n    company_name: item['Company Name'],\n    company_website: item['Company Website'] || '',\n    message: item['What are you looking to automate?'],\n    source: 'website_form',\n    submitted_at: new Date().toISOString()\n  }\n}];"
